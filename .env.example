# Copy to .env (never commit .env). Production secrets live in your host's secret store.
ConnectionStrings__Default=Host=localhost;Port=5435;Database=herproof;Username=herproof;Password=dev_only_change_me

# GitHub App or OAuth App
GitHub__ClientId=
GitHub__ClientSecret=

# Optional, free, strongly recommended before a live demo: a classic personal access token with no
# scopes (public repo read only) at github.com/settings/tokens. Unauthenticated requests are capped
# at 60/hour per IP — a handful of repo submissions during rehearsal can exhaust that; a token raises
# it to 5000/hour. No cost, no paid tier.
GitHub__Token=

# AI provider (behind IAIService). Groq is tried first (free, no card — console.groq.com), then
# Anthropic (AI__ApiKey, paid) if Groq isn't set, then FakeAiService if neither is set.
Groq__ApiKey=
Groq__Model=
AI__Provider=
AI__ApiKey=
AI__Model=
AI__MonthlyBudgetUsd=

# Speech (behind ISpeechToText and ITextToSpeech). Voice recognition in the browser (free, built-in,
# Chrome/Edge) is the default candidate-facing path and needs nothing here — these are only for the
# optional server-side fallback if you ever add a real key.
Speech__Provider=azure
Speech__Key=
Speech__Region=
Speech__Locale=en-ZA

# Object storage (MinIO locally) — not currently used by any implemented feature (see docs/STUBS.md HP-035).
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=devminio
Storage__SecretKey=dev_only_change_me
Storage__Bucket=herproof

# Email (Mailpit locally, no keys needed). Set Brevo__ApiKey to send real email instead — free tier,
# no card, at app.brevo.com. Brevo__SenderEmail must be a sender verified in that Brevo account.
Smtp__Host=localhost
Smtp__Port=1025
Brevo__ApiKey=
Brevo__SenderEmail=
Brevo__SenderName=HerProof

# "Partner with us" form (PartnerController) emails this address on every new inquiry, in addition to
# storing it in PartnershipInquiries (visible at /admin/partner-inquiries). Optional — the inquiry is
# still saved if this is blank, you just won't get an email ping.
Partner__NotificationEmail=

# Interviewer persona (display name only, change freely)
Interviewer__Name=Thandi

# Demo mode: serves cached analyses and interviews if providers fail. NEVER enable in production.
Demo__Enabled=false
