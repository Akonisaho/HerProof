# Copy to .env (never commit .env). Production secrets live in your host's secret store.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=herproof;Username=herproof;Password=dev_only_change_me

# GitHub App or OAuth App
GitHub__ClientId=
GitHub__ClientSecret=

# AI provider (behind IAIService)
AI__Provider=
AI__ApiKey=
AI__Model=
AI__MonthlyBudgetUsd=

# Speech (behind ISpeechToText and ITextToSpeech)
Speech__Provider=azure
Speech__Key=
Speech__Region=
Speech__Locale=en-ZA

# Object storage (MinIO locally)
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=devminio
Storage__SecretKey=dev_only_change_me
Storage__Bucket=herproof

# Email (Mailpit locally)
Smtp__Host=localhost
Smtp__Port=1025

# Interviewer persona (display name only, change freely)
Interviewer__Name=Thandi

# Demo mode: serves cached analyses and interviews if providers fail. NEVER enable in production.
Demo__Enabled=false
