# Build-and-test runner for UNTRUSTED candidate code.
# Run ONLY with the flags in docs/03 section 5, for example:
#   docker run --rm --network none --read-only \
#     --tmpfs /work:rw,size=1024m,exec,uid=10001,gid=10001,mode=1777 \
#     --tmpfs /tmp:rw,size=64m,uid=10001,gid=10001,mode=1777 \
#     --cap-drop ALL --security-opt no-new-privileges --pids-limit 256 \
#     --memory 1g --cpus 1 --user 10001:10001 --env HOME=/work \
#     -v <readonly-input>:/input:ro herproof-sandbox
# The tmpfs uid/gid/mode are required, not cosmetic - a bare --tmpfs mount is root-owned, and without
# them the entrypoint's own first write fails with "Permission denied" before reaching candidate code.
# --env HOME=/work is required too: Docker Desktop on Windows has been observed leaking the host's own
# HOME/USERPROFILE-derived value into the container (a mangled Windows path), overriding the image's
# real, read-only /home/runner - dotnet's first-time-use setup then tries to write its NuGet migration
# lock file under that bogus HOME and fails before restore/build/test ever run.
# Prefer a separate host. The platform must never mount the Docker socket into any container.
FROM mcr.microsoft.com/dotnet/sdk:11.0
RUN useradd -u 10001 -m runner
WORKDIR /work

# Runtime containers always run with --network none, so a candidate's practical-assessment submission
# (wrapped in a real test project by AssessmentSandboxProjectScaffold) could never restore its test
# packages from nuget.org. Bake the exact pinned versions that scaffold uses into the image here, at
# build time, when network is actually available - restore at runtime then resolves entirely from
# this offline cache, never touches the network. sandbox-test-template.csproj's package versions must
# stay in lockstep with src/HerProof.Application/Assessments/AssessmentSandboxProjectScaffold.cs.
COPY docker/sandbox-test-template.csproj /tmp/test-template/TestTemplate.csproj
RUN mkdir -p /opt/nuget-cache \
    && dotnet restore /tmp/test-template/TestTemplate.csproj --packages /opt/nuget-cache \
    && rm -rf /tmp/test-template

COPY --chmod=0555 docker/sandbox-entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
USER 10001:10001
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_CLI_HOME=/work/.dotnet NUGET_PACKAGES=/work/.nuget \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 TMPDIR=/work/tmp
# The root filesystem is --read-only at runtime (only /work is writable, via tmpfs). dotnet's own
# first-time-use setup creates a named Mutex ("NuGet-Migrations") backed by a lock file under whatever
# Path.GetTempPath() resolves to (TMPDIR, defaulting to /tmp) - against the real /tmp this fails with
# "System.IO.IOException: The system cannot open the device or file specified." before restore/build/
# test ever run. Confirmed live: this was the actual cause of every automated run coming back with
# restore_ok:false. Pointing TMPDIR at the writable tmpfs (entrypoint creates it) fixes it.
ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint.sh"]
