<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HerProof</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HerProof.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light brand-navbar mb-0">
            <div class="container">
                <a class="navbar-brand brand-wordmark" asp-area="" asp-controller="Home" asp-action="Index">Her<span>Proof</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Opportunities" asp-action="Index">Opportunities</a>
                        </li>
                        @if (User.IsInRole("Candidate"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Repositories" asp-action="Index">Repositories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Interview" asp-action="Index">My interviews</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Passport" asp-action="Index">My Passport</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/my-profile">My Profile</a>
                            </li>
                        }
                        @if (User.IsInRole("Assessor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="AssessorDashboard" asp-action="Index">Assessor inbox @await Component.InvokeAsync("AssessorInboxBadge")</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Users">Admin</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item ms-sm-2">
                                <a class="btn-brand" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="brand-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <span class="brand-wordmark">Her<span>Proof</span></span>
                    <p class="mt-3 max-w-sm text-sm">
                        Turning what a woman can actually do into a verified, portable credential - evidence before verification, always.
                    </p>
                </div>
                <div class="col-md-4">
                    <h4>Product</h4>
                    <a asp-controller="Opportunities" asp-action="Index">Opportunities</a>
                    <a asp-controller="Home" asp-action="Index">How it works</a>
                </div>
                <div class="col-md-4">
                    <h4>Company</h4>
                    <a asp-controller="Home" asp-action="Privacy">Privacy &amp; data</a>
                    <a asp-controller="Partner" asp-action="Index">Partner with us</a>
                </div>
            </div>
            <div class="footer-bottom">&copy; 2026 HerProof. Built for the SheCode Hackathon.</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
