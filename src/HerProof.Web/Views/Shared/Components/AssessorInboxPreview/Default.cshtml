@model IReadOnlyList<HerProof.Web.Models.Verification.InboxMessageRow>
@if (Model.Count == 0)
{
    <li><span class="dropdown-item-text text-muted small">Nothing pending review right now.</span></li>
}
else
{
    @foreach (var m in Model)
    {
        <li>
            <a class="dropdown-item inbox-message-item @(m.IsUnread ? "is-unread" : "")"
               asp-controller="AssessorDashboard" asp-action="EvidencePack"
               asp-route-candidateId="@m.CandidateId" asp-route-competencyId="@m.CompetencyId">
                @if (m.IsUnread)
                {
                    <span class="inbox-dot" aria-hidden="true"></span>
                }
                <span class="d-block">
                    <strong>@m.CandidateName</strong> submitted &middot; @m.CompetencyName
                </span>
                <span class="d-block text-muted small">@m.UpdatedAtUtc.ToString("d MMM yyyy HH:mm")</span>
            </a>
        </li>
    }
}
<li><hr class="dropdown-divider" /></li>
<li><a class="dropdown-item text-center fw-bold" asp-controller="AssessorDashboard" asp-action="Index">View all in inbox</a></li>
