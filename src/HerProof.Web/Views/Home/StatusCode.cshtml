@model int
@{
    var (title, message) = Model switch
    {
        404 => ("Page not found", "The page you're looking for doesn't exist, or you don't have a link to it."),
        403 => ("Access denied", "You don't have permission to view this page."),
        429 => ("Too many requests", "Please wait a moment and try again."),
        _ => ("Something went wrong", "Please try again, or go back to the homepage."),
    };
    ViewData["Title"] = title;
}

<h1>@title</h1>
<p>@message</p>
<p><a asp-controller="Home" asp-action="Index">Back to the homepage</a></p>
