@model HerProof.Domain.Opportunities.Opportunity
@using HerProof.Application.Opportunities
@using HerProof.Domain.Competencies
@using HerProof.Domain.Opportunities
@{
    ViewData["Title"] = Model.Title;
    var organisationName = (string)ViewBag.OrganisationName;
    var competencyNames = (IReadOnlyDictionary<Guid, string>)ViewBag.CompetencyNames;
    var eligibility = (OpportunityEligibilitySummary?)ViewBag.Eligibility;
    var alreadyApplied = (bool)ViewBag.AlreadyApplied;
    var gapReport = (GapReport?)ViewBag.GapReport;
    var learningProgressByResourceId = ViewBag.LearningProgressByResourceId as IReadOnlyDictionary<Guid, LearningProgressStatus> ?? new Dictionary<Guid, LearningProgressStatus>();
    var candidateCompetencyStatusByCompetencyId = ViewBag.CandidateCompetencyStatusByCompetencyId as IReadOnlyDictionary<Guid, CandidateCompetencyStatus> ?? new Dictionary<Guid, CandidateCompetencyStatus>();
    var ownedCredentials = ViewBag.OwnedCredentials as List<(string CredentialIdentifier, string CompetencyName)> ?? [];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;

    var pillClass = Model.OpportunityType switch
    {
        OpportunityType.Bursary => "opportunity-pill opportunity-pill-bursary",
        OpportunityType.Internship => "opportunity-pill opportunity-pill-internship",
        _ => "opportunity-pill opportunity-pill-job",
    };

    static string StateLabel(EvidenceState state) => state switch
    {
        EvidenceState.Demonstrated => "Demonstrated",
        EvidenceState.ClaimedNotAssessed => "Not yet assessed",
        EvidenceState.NotDemonstrated => "Not demonstrated",
        EvidenceState.NoEvidence => "No evidence yet",
        _ => state.ToString(),
    };

    static string StateBadgeClass(EvidenceState state) => state switch
    {
        EvidenceState.Demonstrated => "badge bg-success",
        EvidenceState.ClaimedNotAssessed => "badge bg-warning text-dark",
        EvidenceState.NotDemonstrated => "badge bg-secondary",
        EvidenceState.NoEvidence => "badge bg-light text-dark border",
        _ => "badge bg-light text-dark",
    };

    static string FormatSalary(decimal? min, decimal? max)
    {
        if (min is null && max is null)
        {
            return "Salary: N/A";
        }

        if (min is not null && (max is null || max == min))
        {
            return $"${min:N0}";
        }

        if (min is null && max is not null)
        {
            return $"Up to ${max:N0}";
        }

        return $"${min:N0} – ${max:N0}";
    }
}

<p class="mt-3"><a asp-action="Index">← Back to opportunities</a></p>

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="@pillClass">@Model.OpportunityType</span>
        <h1 class="mt-3">@Model.Title</h1>
        <p class="opportunity-org">@organisationName</p>
        <div class="opportunity-meta mb-3">
            @if (!string.IsNullOrEmpty(Model.Location))
            {
                <span>📍 @Model.Location</span>
            }
            @if (Model.DeadlineUtc is not null)
            {
                <span>⏳ Closes @Model.DeadlineUtc.Value.ToString("d MMM yyyy")</span>
            }
            <span>💰 @FormatSalary(Model.SalaryMin, Model.SalaryMax)</span>
            @if (Model.ExperienceYearsRequired is not null)
            {
                <span>🧑‍💻 @Model.ExperienceYearsRequired+ yrs experience</span>
            }
        </div>
        <p class="lead mb-0">@Model.Description</p>
    </div>
</div>

<section class="brand-section">
    <h2>Required competencies</h2>
    @if (gapReport is not null)
    {
        <p class="text-muted">
            Three distinct states - none of them a zero (CLAUDE.md rule 2): <strong>Demonstrated</strong>,
            <strong>Not yet assessed</strong> (claimed or no evidence), and <strong>Not demonstrated</strong> (assessed and found wanting).
        </p>
        <div class="d-flex flex-column gap-3 mb-3">
            @foreach (var item in gapReport.Items)
            {
                <div class="brand-card">
                    <span class="@StateBadgeClass(item.EvidenceState)">@StateLabel(item.EvidenceState)</span>
                    <strong>@competencyNames.GetValueOrDefault(item.CompetencyId, "(unknown)")</strong>
 - required level @item.RequiredLevel
                    @(item.DemonstratedLevel is not null ? $", demonstrated level {item.DemonstratedLevel}" : "")
                    <div class="text-muted small mt-1">@item.Explanation</div>

                    @if (item.LearningResourceId is not null)
                    {
                        var progressStatus = learningProgressByResourceId.GetValueOrDefault(item.LearningResourceId.Value, LearningProgressStatus.NotStarted);
                        <form asp-controller="Learning" asp-action="SetProgress" asp-route-learningResourceId="@item.LearningResourceId" method="post" class="mt-2 d-flex align-items-center flex-wrap gap-2">
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <span class="text-muted small">Learning progress: <strong>@progressStatus</strong></span>
                            @if (progressStatus != LearningProgressStatus.InProgress)
                            {
                                <button type="submit" name="status" value="InProgress" class="btn btn-sm btn-outline-secondary">Mark started</button>
                            }
                            @if (progressStatus != LearningProgressStatus.Completed)
                            {
                                <button type="submit" name="status" value="Completed" class="btn btn-sm btn-outline-success">Mark completed</button>
                            }
                        </form>
                    }

                    @if (candidateCompetencyStatusByCompetencyId.TryGetValue(item.CompetencyId, out var ccStatus)
                        && ccStatus is CandidateCompetencyStatus.Developing or CandidateCompetencyStatus.NotDemonstrated)
                    {
                        <form asp-controller="Learning" asp-action="RequestReassessment" asp-route-competencyId="@item.CompetencyId" method="post" class="mt-2">
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Request reassessment</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var rc in Model.RequiredCompetencies)
            {
                <div class="brand-card">
                    @competencyNames.GetValueOrDefault(rc.CompetencyId, "(unknown)") - level @rc.RequiredLevel @(rc.IsMandatory ? "(mandatory)" : "(preferred)")
                </div>
            }
        </div>
    }

    @if (eligibility is not null)
    {
        <h2>Eligibility</h2>
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var rule in eligibility.Rules)
            {
                <div class="brand-card">
                    @rule.Explanation - <strong>@rule.Result</strong>
                    <span class="text-muted">@(rule.IsHardFilter ? "(required)" : "(informational)")</span>
                </div>
            }
        </div>

        @if (alreadyApplied)
        {
            <p><em>You've already applied to this opportunity.</em></p>
        }
        else if (eligibility.IsBlockedByHardFilter)
        {
            <p class="text-danger">You do not currently meet a required eligibility rule for this opportunity.</p>
        }
        else if (ownedCredentials.Count == 0)
        {
            <div class="dev-link-box mb-0">
                <p class="dev-link-label mb-0">You need a verified Skills Passport credential first</p>
                <p class="mb-2">Evidence before verification: you can't apply until an Assessor has verified at least one of your competencies.
                   Submit a repository for the <strong>C#</strong>/<strong>OOP</strong> competencies above, or take a practical assessment, then come back here.</p>
                <a asp-controller="Repositories" asp-action="Index" class="btn-brand">Submit a repository</a>
            </div>
        }
        else
        {
            <form asp-action="Apply" asp-route-opportunityId="@Model.Id" method="post" class="brand-card">
                @if (ownedCredentials.Count > 0)
                {
                    <p>Attach any of your verified Skills Passport credentials to this application (optional):</p>
                    foreach (var (identifier, competencyName) in ownedCredentials)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="selectedCredentialIdentifiers" value="@identifier" id="apply-cred-@identifier" />
                            <label class="form-check-label" for="apply-cred-@identifier">@competencyName (@identifier)</label>
                        </div>
                    }
                }
                <button type="submit" class="btn-brand mt-2">Apply</button>
            </form>
        }
    }
</section>
