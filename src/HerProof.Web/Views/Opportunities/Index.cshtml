@model IReadOnlyList<HerProof.Web.Models.Opportunities.OpportunityListItem>
@using HerProof.Domain.Opportunities
@using HerProof.Web.Models.Opportunities
@{
    ViewData["Title"] = "Opportunities";
    var search = (OpportunitySearchViewModel)ViewBag.Search;

    static string FormatSalary(decimal? min, decimal? max)
    {
        if (min is null && max is null)
        {
            return "Salary: N/A";
        }

        if (min is not null && (max is null || max == min))
        {
            return $"${min:N0}";
        }

        if (min is null && max is not null)
        {
            return $"Up to ${max:N0}";
        }

        return $"${min:N0} – ${max:N0}";
    }
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Opportunities</span>
        <h1>Jobs, internships, and bursaries for verified skills</h1>
        <p class="lead lead-full">
            Every opportunity below is matched against your own Skills Passport - you'll see exactly
            which requirements you already meet and which still need evidence before you apply.
        </p>
    </div>
</div>

<section class="brand-section pb-0">
    <form method="get" class="brand-card mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Search skills, title or description</label>
                <input type="text" name="Q" value="@search.Q" class="form-control" placeholder="e.g. C#, API development" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Type</label>
                <select name="Type" class="form-select">
                    <option value="">Any</option>
                    @foreach (var t in Enum.GetValues<OpportunityType>())
                    {
                        <option value="@t" selected="@(search.Type == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Location</label>
                <input type="text" name="Location" value="@search.Location" class="form-control" placeholder="Any" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Max years' experience</label>
                <input type="number" name="MaxExperienceYears" value="@search.MaxExperienceYears" min="0" max="60" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-brand flex-grow-1">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters">✕</a>
            </div>
        </div>
        <div class="form-check mt-2">
            <input type="checkbox" name="HasSalaryDisclosed" value="true" class="form-check-input" id="hasSalaryDisclosed" checked="@search.HasSalaryDisclosed" />
            <label class="form-check-label small" for="hasSalaryDisclosed">Only show opportunities with salary disclosed</label>
        </div>
    </form>
</section>

<section class="brand-section pt-0">
    @if (Model.Count == 0)
    {
        <div class="brand-card text-center">
            <h3>No open opportunities right now</h3>
            <p>Check back soon - new roles and bursaries are posted regularly.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var opportunity = item.Opportunity;
                var pillClass = opportunity.OpportunityType switch
                {
                    OpportunityType.Bursary => "opportunity-pill opportunity-pill-bursary",
                    OpportunityType.Internship => "opportunity-pill opportunity-pill-internship",
                    _ => "opportunity-pill opportunity-pill-job",
                };

                <div class="col-md-6 col-lg-4">
                    <a asp-action="Details" asp-route-opportunityId="@opportunity.Id" class="opportunity-card brand-card h-100 d-block">
                        <span class="@pillClass">@opportunity.OpportunityType</span>
                        <h3 class="mt-3">@opportunity.Title</h3>
                        <p class="opportunity-org mb-2">@item.OrganisationName</p>
                        <p class="mb-0">@opportunity.Description</p>
                        <div class="opportunity-meta mt-3">
                            @if (!string.IsNullOrEmpty(opportunity.Location))
                            {
                                <span>📍 @opportunity.Location</span>
                            }
                            @if (opportunity.DeadlineUtc is not null)
                            {
                                <span>⏳ Closes @opportunity.DeadlineUtc.Value.ToString("d MMM yyyy")</span>
                            }
                            <span>💰 @FormatSalary(opportunity.SalaryMin, opportunity.SalaryMax)</span>
                            @if (opportunity.ExperienceYearsRequired is not null)
                            {
                                <span>🧑‍💻 @opportunity.ExperienceYearsRequired+ yrs experience</span>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</section>
