@model HerProof.Web.Models.Learning.CareerRoadmapViewModel
@using HerProof.Domain.Assessments
@using HerProof.Domain.Competencies
@{
    ViewData["Title"] = "Not sure where to start?";

    static string StatusPillClass(CandidateCompetencyStatus? status) => status switch
    {
        CandidateCompetencyStatus.Verified => "status-pill status-pill-success",
        CandidateCompetencyStatus.NotDemonstrated => "status-pill status-pill-danger",
        CandidateCompetencyStatus.Developing => "status-pill status-pill-warning",
        null => "status-pill",
        _ => "status-pill status-pill-warning",
    };

    static string StatusLabel(CandidateCompetencyStatus? status) => status switch
    {
        null => "Not started yet",
        CandidateCompetencyStatus.Verified => "Verified",
        _ => status.ToString()!,
    };
}

<div class="hero-wrap hero-wrap-tight">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Career roadmap</span>
        <h1>Not sure where to start?</h1>
        <p class="lead lead-full mb-0">
            Search what you want to become. Each step unlocks the next only once you've actually taken
            and passed its real practical assessment - no skipping ahead.
        </p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    <div class="row g-3 mb-4 align-items-stretch">
        <div class="col-lg-7">
            <form asp-action="Roadmap" method="get" class="brand-card h-100">
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label small">Search for a goal</label>
                        <input type="text" name="search" class="form-control" placeholder="e.g. &quot;I want to become a software developer&quot; or &quot;data engineer&quot;" value="@Context.Request.Query["search"]" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn-brand btn-form-inline w-100">Search</button>
                    </div>
                </div>

                @if (Model.AvailableGoals.Count == 0)
                {
                    <p class="text-muted small mt-3 mb-0">No goal matches that search yet.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @foreach (var g in Model.AvailableGoals)
                        {
                            <a asp-action="Roadmap" asp-route-goal="@g" class="@(g == Model.SelectedGoal ? "btn-brand" : "btn-brand-outline") btn-sm">@g</a>
                        }
                    </div>
                }
            </form>
        </div>
        <div class="col-lg-5">
            <button type="button" class="brand-card career-guide-trigger-card h-100 w-100 d-flex flex-column align-items-center justify-content-center text-center"
                    style="border: none; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#career-guide-modal">
                <span class="d-inline-flex align-items-center justify-content-center mb-2" style="width: 3rem; height: 3rem; border-radius: 50%; background: var(--brand-pink);">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" style="width: 1.5rem; height: 1.5rem; color: #fff;">
                        <path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                    </svg>
                </span>
                <strong>Or just ask</strong>
                <span class="text-muted small">Tell the career guide what you enjoy or want to become</span>
            </button>
        </div>
    </div>

    <div class="modal fade" id="career-guide-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content career-guide-surface" style="border: none;">
                <div class="modal-header career-guide-header">
                    <div>
                        <strong>Career guide</strong>
                        <span class="text-muted small d-block">Not sure where to start? Just ask.</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div id="career-guide-inline-messages" class="career-guide-messages" style="min-height: 22rem;"></div>
                <form id="career-guide-inline-form" class="career-guide-form">
                    <input type="text" id="career-guide-inline-input" placeholder="e.g. I'm good with numbers, not sure what role fits" autocomplete="off" />
                    <button type="button" class="btn-brand btn-sm">Send</button>
                </form>
            </div>
        </div>
    </div>

    @if (Model.JustCompletedCompetencyNames.Count > 0)
    {
        <div class="brand-card mb-4" style="border-color: var(--brand-success);">
            <strong style="color: var(--brand-success);">Step complete!</strong>
            Real evidence closed the gap on
            <strong>@string.Join(", ", Model.JustCompletedCompetencyNames)</strong> -
            the next step is unlocked.
        </div>
    }

    @if (Model.Steps is not null)
    {
        <div class="d-flex flex-column gap-0">
            @for (var i = 0; i < Model.Steps.Count; i++)
            {
                var step = Model.Steps[i];
                <div class="d-flex gap-3 align-items-stretch">
                    <div class="d-flex flex-column align-items-center" style="width: 2.5rem;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 2.5rem; height: 2.5rem; font-weight: 700; flex-shrink: 0;
                                    background: @(step.IsCompleted ? "var(--brand-success)" : step.IsLocked ? "#e9e9ee" : "var(--brand-pink)");
                                    color: @(step.IsLocked && !step.IsCompleted ? "#9a97a3" : "#fff");">
                            @(step.IsCompleted ? "✓" : step.IsLocked ? "🔒" : step.StepNumber.ToString())
                        </div>
                        @if (i < Model.Steps.Count - 1)
                        {
                            <div style="width: 2px; flex: 1; min-height: 1.5rem; background: @(step.IsCompleted ? "var(--brand-success)" : "#e9e9ee");"></div>
                        }
                    </div>

                    <div class="brand-card flex-grow-1 mb-3" style="opacity: @(step.IsLocked ? "0.6" : "1");">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                            <div>
                                <span class="opportunity-org d-block">Step @step.StepNumber of @Model.Steps.Count</span>
                                <strong>@step.CompetencyName</strong> - target level @step.TargetLevel
                            </div>
                            <span class="@StatusPillClass(step.CurrentStatus)">@StatusLabel(step.CurrentStatus)</span>
                        </div>

                        @if (step.IsLocked)
                        {
                            <p class="text-muted small mb-0">Complete the step above first to unlock this one.</p>
                        }
                        else
                        {
                            @if (step.Resources.Count > 0)
                            {
                                <div class="mb-2">
                                    <span class="text-muted small d-block mb-1">Learn this first</span>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var resource in step.Resources)
                                        {
                                            <a href="@resource.Url" target="_blank" rel="noopener" class="btn-brand-outline btn-sm">@resource.Title (@resource.CostType)</a>
                                        }
                                    </div>
                                </div>
                            }

                            @if (step.IsCompleted)
                            {
                                <p class="small mb-0" style="color: var(--brand-success);">Passed - built and all tests green.</p>
                            }
                            else if (step.AvailableAssessments.Count == 0)
                            {
                                <p class="text-muted small mb-0">No practical assessment covers this skill yet - ask an admin to add one.</p>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var a in step.AvailableAssessments)
                                    {
                                        <div>
                                            <form asp-controller="AssessmentSessions" asp-action="Start" asp-route-assessmentId="@a.Id" method="post">
                                                <button type="submit" class="btn-brand btn-sm">Take: @a.Title (@a.DurationMinutes min)</button>
                                            </form>
                                            @if (a.AlsoCovers.Count > 0)
                                            {
                                                <p class="text-muted small mb-0 mt-1">
                                                    One shared practical - passing it also completes @string.Join(" and ", a.AlsoCovers) on this roadmap.
                                                </p>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @if (Model.AllStepsCompleted)
        {
            var languageLabel = Model.GoalLanguage switch
            {
                AssessmentLanguage.CSharp => "C#",
                AssessmentLanguage.Java => "Java",
                _ => "the language you've been learning",
            };
            <div class="brand-card mt-2" style="background: var(--brand-code-bg); color: #fff;">
                <h3 class="h5 mb-2" style="color: #fff;">Ready for the real test</h3>
                <p class="mb-3" style="color: #c9bfe0;">
                    You've closed every gap on this roadmap. Now build the one project that actually
                    proves it: a real project in <strong>@languageLabel</strong> that solves a real-world
                    problem - not a tutorial exercise, something you'd actually use or show someone.
                    Post it as a public repository, then submit it here and sit a voice interview with
                    Nolwazi about your own code. A named human Assessor - never AI - reviews that evidence
                    and decides whether to verify it on your Skills Passport.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Repositories" asp-action="Index" class="btn-brand">Post your project's repository</a>
                    <a asp-controller="Interview" asp-action="Index" class="btn-brand-outline">Start an interview</a>
                </div>
            </div>
        }

        <div class="brand-card mt-4">
            <h3 class="h5 mb-2">More general places to start</h3>
            <p class="text-muted small mb-2">Not tied to one specific skill above - good for building momentum and community as you go.</p>
            <div class="d-flex flex-wrap gap-2">
                <a href="https://www.shecodesfoundation.org/" target="_blank" rel="noopener" class="btn-brand-outline btn-sm">SheCode Foundation</a>
                <a href="https://www.freecodecamp.org/" target="_blank" rel="noopener" class="btn-brand-outline btn-sm">freeCodeCamp (full curriculum)</a>
                <a href="https://learn.microsoft.com/training/" target="_blank" rel="noopener" class="btn-brand-outline btn-sm">Microsoft Learn</a>
            </div>
        </div>
    }
    else if (Model.SelectedGoal is not null)
    {
        <div class="brand-card">
            <p class="mb-0 text-muted">We don't have a roadmap for that goal yet.</p>
        </div>
    }
</section>
