@model HerProof.Web.Models.Admin.AssignRolesViewModel
@{
    ViewData["Title"] = "Assign roles";
    var userEmail = ViewBag.UserEmail as string;
    var userId = (Guid)ViewBag.UserId;
}

<h1>Assign roles - @userEmail</h1>
<p class="text-muted">Candidate is granted automatically at registration and isn't managed here.</p>

<form asp-action="AssignRoles" asp-route-userId="@userId" method="post">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="Recruiter" id="role-recruiter" />
        <label class="form-check-label" for="role-recruiter">Recruiter</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="Assessor" id="role-assessor" />
        <label class="form-check-label" for="role-assessor">Assessor</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="Partner" id="role-partner" />
        <label class="form-check-label" for="role-partner">Partner (bursary provider)</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="Administrator" id="role-admin" />
        <label class="form-check-label" for="role-admin">Administrator</label>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Users" class="btn btn-secondary mt-3">Cancel</a>
</form>
