@model IReadOnlyList<HerProof.Web.Models.Admin.PartnerInquiryRow>
@using HerProof.Domain.Partnerships
@{
    ViewData["Title"] = "Admin - Partner inquiries";
}

<h1>Partner inquiries</h1>
<p><a asp-action="Users" class="btn btn-outline-secondary btn-sm">Manage users</a></p>

@if (Model.Count == 0)
{
    <p class="text-muted">No partner inquiries yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Received</th>
                <th>Organisation</th>
                <th>Contact</th>
                <th>Type</th>
                <th>Message</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>@row.OrganisationName</td>
                    <td>
                        @row.ContactName<br />
                        <a href="mailto:@row.ContactEmail">@row.ContactEmail</a>
                        @if (!string.IsNullOrWhiteSpace(row.Phone))
                        {
                            <br />@row.Phone
                        }
                    </td>
                    <td>@row.InquiryType</td>
                    <td class="text-pre-wrap">@row.Message</td>
                    <td>@row.Status</td>
                    <td>
                        @if (row.Status != PartnershipInquiryStatus.Contacted)
                        {
                            <form asp-action="MarkPartnerInquiryContacted" asp-route-inquiryId="@row.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Mark contacted</button>
                            </form>
                        }
                        @if (row.Status != PartnershipInquiryStatus.Closed)
                        {
                            <form asp-action="ClosePartnerInquiry" asp-route-inquiryId="@row.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Close</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
