@model HerProof.Web.Models.Admin.OrganisationDetailViewModel
@using HerProof.Domain.Identity
@{
    ViewData["Title"] = $"Admin - {Model.Organisation.Name}";
}

<h1>@Model.Organisation.Name</h1>
<p><a asp-action="Organisations">Back to organisations</a></p>

@if (TempData["AdminError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<h2 class="h5">Members</h2>
@if (Model.Members.Count == 0)
{
    <p class="text-muted">No members yet.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var (memberId, email, role) in Model.Members)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@email - @role</span>
                <form asp-action="RemoveOrganisationMember" asp-route-organisationId="@Model.Organisation.Id" asp-route-memberId="@memberId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
            </li>
        }
    </ul>
}

<h2 class="h5">Add a member</h2>
<p class="text-muted small">
    The user must already have a HerProof account (any role). Adding them here also grants the
    matching Recruiter/Partner sign-in role if they don't already have it.
</p>
<form asp-action="AddOrganisationMember" asp-route-organisationId="@Model.Organisation.Id" method="post" class="row g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label">Email</label>
        <input type="email" name="Email" class="form-control" required />
    </div>
    <div class="col-auto">
        <label class="form-label">Role</label>
        <select name="Role" asp-items="Html.GetEnumSelectList<OrganisationRole>()" class="form-select"></select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add member</button>
    </div>
</form>
