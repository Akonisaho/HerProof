@model HerProof.Web.Models.Interviews.VoiceConsentViewModel
@{
    ViewData["Title"] = "Voice interview consent";
}

<div class="hero-wrap hero-wrap-tight">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Before you start</span>
        <h1>Let's set up your interview</h1>
        <p class="lead lead-full mb-0">
            Nolwazi can ask her questions out loud and let you answer by speaking, instead of typing.
        </p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    <div class="brand-card mb-4">
        <h2 class="h6">How voice works here</h2>
        <ul>
            <li>Your microphone is used only while you're recording an answer - never in the background.</li>
            <li>Your words are turned into text <strong>by your own browser</strong> - the audio never leaves your device or touches a HerProof server at all.</li>
            <li>You always see the resulting text and can correct it before it's submitted.</li>
            <li>This needs a browser that supports it (Chrome or Edge); if yours doesn't, you'll just type instead automatically.</li>
            <li>Only the content of your words is assessed - never your accent, pronunciation or how you sound.</li>
            <li>You can switch to typing at any point, with no penalty.</li>
        </ul>
    </div>

    <form asp-action="Consent" method="post">
        <input type="hidden" asp-for="RepositoryId" />
        @if (Model.OpportunityId is not null)
        {
            <input type="hidden" asp-for="OpportunityId" />
        }
        <button type="submit" name="ConsentGiven" value="true" class="btn-brand">Start the interview</button>
    </form>
</section>
