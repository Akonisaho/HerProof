@model IReadOnlyList<HerProof.Domain.Interviews.Interview>
@using HerProof.Domain.Interviews
@using HerProof.Web.Controllers
@{
    ViewData["Title"] = "My interviews";
    var opportunityTitles = (IReadOnlyDictionary<Guid, string>)ViewBag.OpportunityTitles;
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Thandi</span>
        <h1>My interviews</h1>
        <p class="lead lead-full mb-0">Every voice/text interview you've taken, grounded in your own code.</p>
    </div>
</div>

<section class="brand-section">
    @if (Model.Count == 0)
    {
        <div class="brand-card">
            <p class="mb-0 text-muted">No interviews yet - start one from a repository you've submitted.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var interview in Model)
            {
                var isComplete = interview.Status == InterviewStatus.Completed;
                <div class="opportunity-card brand-card d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a asp-action="@(isComplete ? nameof(InterviewController.Report) : nameof(InterviewController.Take))" asp-route-interviewId="@interview.Id" class="flex-grow-1 text-decoration-none">
                        <strong>@(interview.OpportunityId is Guid oppId ? opportunityTitles.GetValueOrDefault(oppId, "(opportunity)") : "General skills interview")</strong>
                        <span class="opportunity-org d-block">
                            @interview.Mode · Started @interview.StartedAtUtc.ToString("yyyy-MM-dd")
                            @(interview.IsDemoData ? " · Demo data" : "")
                        </span>
                    </a>
                    <div class="d-flex align-items-center gap-2">
                        <span class="device-pill @(isComplete ? "detected" : "")">@interview.Status</span>
                        @if (isComplete)
                        {
                            <a asp-action="ReportPdf" asp-route-interviewId="@interview.Id" class="btn btn-sm btn-outline-secondary">Download report</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>
