@model HerProof.Web.Models.Interviews.SubmitAnswerViewModel
@using HerProof.Domain.Interviews
@{
    ViewData["Title"] = "Interview with Nolwazi";
    var question = (InterviewQuestion)ViewBag.Question;
    var interview = (Interview)ViewBag.Interview;
    var activeTurn = question.Turns.OrderBy(t => t.TurnIndex).Last();
    var isVoice = interview.Mode == InterviewMode.Voice;
    var isFirstQuestion = question.QuestionOrder == 0;
}

@if (isVoice && isFirstQuestion)
{
    <div id="device-check-step" class="brand-card" style="max-width: 560px; margin: 0 auto;">
        <h2 class="h5">Check your camera and microphone</h2>
        <p class="text-muted small">
            This is a live preview only - nothing is recorded or uploaded. Only the content of your
            spoken answers is ever assessed, never your appearance, accent or tone.
        </p>
        <div class="camera-box mx-auto">
            <video id="candidate-camera" autoplay muted playsinline></video>
            <span class="camera-rec-badge d-none" id="camera-rec-badge">● REC</span>
            <div class="camera-sound-meter" aria-hidden="true">
                <span class="camera-sound-bar"></span>
            </div>
        </div>
        <div id="camera-unavailable" class="text-muted small mt-2 d-none text-center">
            Camera/microphone preview isn't available (permission denied or no device found) - you can still take the interview normally, nothing here is required.
        </div>
        <div class="text-center mt-3">
            <button type="button" id="start-interview-btn" class="btn-brand">I'm ready - start the interview</button>
        </div>
    </div>
}

<div id="interview-step" class="@(isVoice && isFirstQuestion ? "d-none" : "")" data-interview-id="@interview.Id">
    <div class="row g-4">
        <div class="col-lg-7 order-2 order-lg-1">
            <div class="card mb-3">
                <div class="card-body">
                    <p class="lead" id="prompt-text">@activeTurn.PromptText</p>
                    @if (!string.IsNullOrEmpty(question.SnippetFilePath))
                    {
                        <p class="small text-muted"><code>@question.SnippetFilePath</code> lines @question.SnippetLines</p>
                    }

                    @if (isVoice)
                    {
                        <button type="button" id="play-question-btn" class="btn btn-sm btn-outline-secondary">🔊 Play question</button>
                        <audio id="prompt-audio" class="d-none"></audio>
                    }
                </div>
            </div>

            @if (isVoice)
            {
                <div class="card mb-3" id="voice-panel" data-interview-id="@interview.Id" data-turn-id="@activeTurn.Id">
                    <div class="card-body">
                        <span id="recording-indicator" class="badge bg-danger">🎤 Listening - speak your answer</span>
                        <div id="voice-unsupported" class="text-muted small mt-2 d-none">
                            Voice recognition isn't supported in this browser (try Chrome or Edge) - please type your answer below.
                        </div>
                        <div id="voice-error" class="text-danger small mt-2 d-none"></div>
                    </div>
                </div>
            }

            <form asp-action="Answer" asp-route-interviewId="@interview.Id" method="post" id="answer-form">
                <input type="hidden" asp-for="TurnId" />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Answer" class="form-label">
                        @(isVoice ? "Your answer (spoken and recorded automatically - not editable)" : "Your answer")
                    </label>
                    @if (isVoice)
                    {
                        <textarea asp-for="Answer" class="form-control" rows="6" id="answer-textarea" required readonly></textarea>
                    }
                    else
                    {
                        <textarea asp-for="Answer" class="form-control" rows="6" id="answer-textarea" required></textarea>
                    }
                </div>
                <button type="submit" class="btn btn-primary">Submit answer and go to next question</button>
            </form>

            <p class="mt-3 small text-muted">Question @(question.QuestionOrder + 1) of @interview.Questions.Count</p>
        </div>

        <div class="col-lg-5 order-1 order-lg-2">
            <div class="thandi-panel brand-card">
                <div class="thandi-avatar thandi-avatar-lg" id="thandi-avatar">
                    <svg class="thandi-face" viewBox="0 0 120 150" aria-hidden="true">
                        <path class="thandi-shoulders" d="M14,150 Q14,104 60,100 Q106,104 106,150 Z" />
                        <circle class="thandi-face-bg" cx="60" cy="56" r="40" />
                        <g class="thandi-eyes">
                            <ellipse class="thandi-eye" cx="46" cy="50" rx="4.2" ry="5.2" />
                            <ellipse class="thandi-eye" cx="74" cy="50" rx="4.2" ry="5.2" />
                        </g>
                        <path class="thandi-mouth" d="M44,72 Q60,77 76,72" />
                    </svg>
                </div>
                <div class="text-center mt-2">
                    <span class="thandi-name">Nolwazi</span>
                    <span class="thandi-status d-block" id="thandi-status">Your interviewer</span>
                    <span class="thandi-thinking-dots d-none" id="thandi-thinking-dots" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </span>
                </div>
                <p class="text-muted small text-center mt-3 mb-0">
                    Only the content of your answers is assessed - never accent, pronunciation,
                    appearance or emotion. Take your time.
                </p>

                @if (isVoice)
                {
                    <div class="camera-box mx-auto mt-3" id="camera-panel-interview">
                        <video id="candidate-camera-interview" autoplay muted playsinline></video>
                        <span class="camera-rec-badge d-none" id="camera-rec-badge-interview">● REC</span>
                        <div class="camera-sound-meter" aria-hidden="true">
                            <span class="camera-sound-bar-interview"></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/interview-thinking.js" asp-append-version="true"></script>
    <script src="~/js/interview-guard.js" asp-append-version="true"></script>
    @if (isVoice)
    {
        <script src="~/js/interview-voice.js" asp-append-version="true"></script>
        <script src="~/js/interview-ajax.js" asp-append-version="true"></script>
        <script src="~/js/interview-camera.js" asp-append-version="true"></script>
    }
}
