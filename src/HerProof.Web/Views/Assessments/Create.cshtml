@model HerProof.Web.Models.Assessments.CreateAssessmentViewModel
@{
    ViewData["Title"] = "Create an assessment";
}

<h1>Create an assessment</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="AssessmentType" class="form-label"></label>
        <select asp-for="AssessmentType" class="form-select">
            <option value="C#">C#</option>
            <option value="Practical">Practical (freeform)</option>
            <option value="Other">Other</option>
        </select>
        <div class="form-text">Selecting C# adds two real practical questions automatically: an implement-a-feature question and a find-and-fix-the-bug question.</div>
    </div>
    <div class="mb-3">
        <label asp-for="DurationMinutes" class="form-label"></label>
        <input asp-for="DurationMinutes" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
