@model IReadOnlyList<HerProof.Domain.Assessments.Assessment>
@{
    ViewData["Title"] = "Your assessments";
}

<div class="hero-wrap hero-wrap-tight">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Practical assessments</span>
        <h1>Your assessments</h1>
        <p class="lead lead-full mb-0">Write your own test, attach it to an opportunity, and candidates take it from there.</p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    <p><a asp-action="Create" class="btn-brand">Create an assessment</a></p>

    @if (Model.Count == 0)
    {
        <div class="brand-card">
            <p class="mb-0 text-muted">You haven't created an assessment yet.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var a in Model)
            {
                <a asp-action="Details" asp-route-assessmentId="@a.Id" class="opportunity-card brand-card d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong>@a.Title</strong>
                        <span class="opportunity-org d-block">@a.AssessmentType &middot; @a.DurationMinutes min</span>
                    </div>
                    <span class="device-pill @(a.Status == HerProof.Domain.Assessments.AssessmentStatus.Published ? "detected" : "")">@a.Status</span>
                </a>
            }
        </div>
    }
</section>
