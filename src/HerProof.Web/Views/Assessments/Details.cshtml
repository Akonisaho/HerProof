@model HerProof.Domain.Assessments.Assessment
@using HerProof.Domain.Assessments
@{
    ViewData["Title"] = Model.Title;
    var competencyNames = (IReadOnlyDictionary<Guid, string>)ViewBag.CompetencyNames;
    var availableCompetencies = ViewBag.AvailableCompetencies;
}

<div class="hero-wrap hero-wrap-tight">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">@Model.AssessmentType &middot; @Model.Language &middot; @Model.DurationMinutes min &middot; @Model.Status</span>
        <h1>@Model.Title</h1>
        <p class="lead lead-full mb-0">@Model.Description</p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    @if (Model.Status == AssessmentStatus.Draft)
    {
        <div class="brand-card mb-4">
            <p class="mb-2">
                This assessment is still a Draft - it can't be attached to an opportunity or started by a
                candidate until it's Published. Add at least one question first.
            </p>
            <form asp-action="Publish" asp-route-assessmentId="@Model.Id" method="post">
                <button type="submit" class="btn-brand">Publish this assessment</button>
            </form>
        </div>
    }

    <div class="brand-card mb-4">
        <h3>Questions</h3>
        <p class="text-muted">
            Write the task yourself and paste in any starter code the candidate should start from - this
            is your own test, not a template.
        </p>
        @if (Model.Questions.Count == 0)
        {
            <p class="text-muted mb-3">No questions yet.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-2 mb-3">
                @foreach (var q in Model.Questions.OrderBy(q => q.Order))
                {
                    <div class="brand-card">
                        <strong>@(q.Order + 1). @q.Title</strong>
                        <span class="opportunity-org d-block">@q.FileName &middot; @q.QuestionType</span>
                        <p class="mb-2">@q.Prompt</p>
                        @if (!string.IsNullOrWhiteSpace(q.StarterCode))
                        {
                            <pre class="small mb-2">@q.StarterCode</pre>
                        }
                        @if (string.IsNullOrWhiteSpace(q.HiddenTestCode))
                        {
                            <span class="status-pill status-pill-warning">No hidden test yet - the sandbox can only confirm it builds, not that it's correct</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill-success">Has a hidden test - genuinely graded in the sandbox</span>
                        }
                    </div>
                }
            </div>
        }

        <form asp-action="AddQuestion" asp-route-assessmentId="@Model.Id" method="post">
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input name="Title" class="form-control" placeholder="e.g. Fix the race condition in OrderService" />
            </div>
            <div class="mb-3">
                <label class="form-label">File name</label>
                <input name="FileName" class="form-control" placeholder="e.g. OrderService.cs" />
            </div>
            <div class="mb-3">
                <label class="form-label">Question type</label>
                <select name="QuestionType" class="form-select">
                    <option value="Implement">Implement (candidate builds it from scratch)</option>
                    <option value="FixBug">Fix bug (candidate is given broken code to repair)</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Prompt - what the candidate is asked to do</label>
                <textarea name="Prompt" class="form-control" rows="3" placeholder="Describe the real task in your own words..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Starter code - paste or type what the candidate should start from</label>
                <textarea name="StarterCode" class="form-control text-pre-wrap" rows="10" style="font-family: monospace;" placeholder="// Paste real code here - the broken version, a skeleton, or leave blank to start from nothing"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">
                    Hidden test (never shown to the candidate) -
                    @(Model.Language == AssessmentLanguage.Java ? "a real JUnit 5 test class" : "a real xUnit test class")
                    that actually checks her submission is correct, not just that it builds
                </label>
                <textarea name="HiddenTestCode" class="form-control text-pre-wrap" rows="10" style="font-family: monospace;"
                          placeholder="@(Model.Language == AssessmentLanguage.Java
                                          ? "import org.junit.jupiter.api.Test;\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class HiddenTest1 {\n    @Test\n    void worksCorrectly() {\n        assertEquals(expected, actual);\n    }\n}"
                                          : "using Xunit;\n\npublic class HiddenTests\n{\n    [Fact]\n    public void WorksCorrectly()\n    {\n        Assert.Equal(expected, actual);\n    }\n}")"></textarea>
                <div class="form-text">
                    Leave blank and the sandbox still runs - it just can't prove correctness beyond "it builds."
                </div>
            </div>
            <button type="submit" class="btn-brand-outline">Add question</button>
        </form>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="brand-card h-100">
                <h3>Competencies covered</h3>
                @if (Model.Competencies.Count == 0)
                {
                    <p class="text-muted">None added yet.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var c in Model.Competencies)
                        {
                            <li>@competencyNames.GetValueOrDefault(c.CompetencyId, "(unknown)") - weight @c.Weight</li>
                        }
                    </ul>
                }
                <form asp-action="AddCompetency" asp-route-assessmentId="@Model.Id" method="post" class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Competency</label>
                        <select name="CompetencyId" class="form-select">
                            @foreach (var c in availableCompetencies)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Weight</label>
                        <input type="number" step="0.1" name="Weight" value="1" class="form-control" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn-brand-outline">Add</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-6">
            <div class="brand-card h-100">
                <h3>Rubric criteria</h3>
                @if (Model.RubricCriteria.Count == 0)
                {
                    <p class="text-muted">None added yet.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var r in Model.RubricCriteria)
                        {
                            <li><strong>@r.Name</strong> (weight @r.Weight) - @r.Descriptor</li>
                        }
                    </ul>
                }
                <form asp-action="AddRubricCriterion" asp-route-assessmentId="@Model.Id" method="post" class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Name</label>
                        <input name="Name" class="form-control" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Weight</label>
                        <input type="number" step="0.1" name="Weight" value="1" class="form-control" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Descriptor</label>
                        <input name="Descriptor" class="form-control" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn-brand-outline">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
