@model IReadOnlyList<HerProof.Domain.Repositories.Repository>
@using HerProof.Domain.Repositories
@using HerProof.Domain.Opportunities
@{
    ViewData["Title"] = "Your repositories";
    var latestByRepository = (IReadOnlyDictionary<Guid, RepositoryAnalysis>)ViewBag.LatestAnalysisByRepository;
    var opportunities = (IReadOnlyList<Opportunity>)ViewBag.PublishedOpportunities;

    static string StatusPillClass(RepositoryAnalysisStatus status) => status switch
    {
        RepositoryAnalysisStatus.Completed => "status-pill status-pill-success",
        RepositoryAnalysisStatus.Failed => "status-pill status-pill-danger",
        RepositoryAnalysisStatus.NeedsRetry => "status-pill status-pill-warning",
        _ => "status-pill",
    };

    static (string Class, string Label) ContributorBadge(ContributorVerificationStatus status) => status switch
    {
        ContributorVerificationStatus.Confirmed => ("status-pill status-pill-success", "✓ Contributor confirmed"),
        ContributorVerificationStatus.NotConfirmed => ("status-pill status-pill-warning", "Contributor not confirmed"),
        _ => ("status-pill", "Contributor not checked"),
    };
}

<div class="hero-wrap hero-wrap-tight">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Your code</span>
        <h1>Your repositories</h1>
        <p class="lead lead-full mb-0">Submit a GitHub repo and Nolwazi will ground her interview questions in your real work.</p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    <a asp-action="Submit" class="btn-brand mb-3 d-inline-block">Submit a repository</a>

    @if (TempData["AnalysisMessage"] is string analysisMessage)
    {
        <div class="alert alert-info">@analysisMessage</div>
    }
    @if (TempData["InterviewMessage"] is string interviewMessage)
    {
        <div class="alert alert-warning">@interviewMessage</div>
    }

    @if (Model.Count == 0)
    {
        <div class="brand-card text-center">
            <p class="mb-0 text-muted">No repositories yet - submit one to get started.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var repo in Model)
            {
                var (contributorClass, contributorLabel) = ContributorBadge(repo.ContributorStatus);
                <div class="brand-card">
                    <div class="repo-card-head">
                        <div>
                            <a href="@repo.RepositoryUrl" target="_blank" rel="noopener" class="repo-name">@repo.RepositoryName</a>
                            <div class="repo-meta">
                                <span>Branch <code>@repo.Branch</code></span>
                                <span>Commit <code>@repo.CommitSha[..Math.Min(7, repo.CommitSha.Length)]</code></span>
                                <span>Submitted @repo.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>
                        <span class="@contributorClass">@contributorLabel</span>
                    </div>

                    <div class="repo-status-cell mt-3" data-repository-id="@repo.Id">
                        @if (latestByRepository.TryGetValue(repo.Id, out var analysis))
                        {
                            var isPending = analysis.Status is RepositoryAnalysisStatus.Pending or RepositoryAnalysisStatus.InProgress;
                            <div class="d-flex align-items-center gap-2 flex-wrap repo-status-badge @(isPending ? "d-none" : "")">
                                <span class="@StatusPillClass(analysis.Status)">@analysis.Status</span>
                            </div>
                            @if (isPending)
                            {
                                <span class="repo-status-spinner d-inline-flex align-items-center gap-2">
                                    <span class="spinner-border spinner-border-sm text-muted" role="status" aria-hidden="true"></span>
                                    <span class="text-muted small">Analysing...</span>
                                </span>
                            }
                            @if (analysis.Status == RepositoryAnalysisStatus.Completed)
                            {
                                <p class="repo-summary mb-0">
                                    @analysis.Summary
                                    <span class="text-muted">(@analysis.Findings.Count finding@(analysis.Findings.Count == 1 ? "" : "s"), model: @analysis.ModelVersion)</span>
                                </p>

                                <div class="repo-interview-actions">
                                    <form asp-controller="Interview" asp-action="Consent" method="get">
                                        <input type="hidden" name="repositoryId" value="@repo.Id" />
                                        <button type="submit" class="btn-brand">Prove your skills with Nolwazi</button>
                                    </form>

                                    @if (opportunities.Count > 0)
                                    {
                                        <form asp-controller="Interview" asp-action="Consent" method="get" class="opportunity-picker">
                                            <span class="text-muted small">or for a specific opportunity:</span>
                                            <select name="opportunityId" class="form-select form-select-sm">
                                                @foreach (var o in opportunities)
                                                {
                                                    <option value="@o.Id">@o.Title</option>
                                                }
                                            </select>
                                            <input type="hidden" name="repositoryId" value="@repo.Id" />
                                            <button type="submit" class="btn-brand-outline btn-sm">Start</button>
                                        </form>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/repositories-poll.js" asp-append-version="true"></script>
}
