@model HerProof.Web.Models.Account.EditProfileViewModel
@using HerProof.Domain.Competencies
@{
    ViewData["Title"] = "Edit your profile";
    var candidateProfileId = Guid.Parse(ViewContext.RouteData.Values["candidateProfileId"]!.ToString()!);
    var availableCompetencies = ViewBag.AvailableCompetencies as List<Competency> ?? [];
}

<h1>Edit your profile</h1>
<p class="text-muted">
    Everything here is optional, and only used for bursary/job eligibility checks and to help gap
    reports - never for AI scoring of your competency evidence.
</p>

<form asp-action="Edit" asp-route-candidateProfileId="@candidateProfileId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Province</label>
        <select asp-for="Province" class="form-select">
            <option value="">Prefer not to say</option>
            <option>Eastern Cape</option>
            <option>Free State</option>
            <option>Gauteng</option>
            <option>KwaZulu-Natal</option>
            <option>Limpopo</option>
            <option>Mpumalanga</option>
            <option>Northern Cape</option>
            <option>North West</option>
            <option>Western Cape</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Education level</label>
        <select asp-for="EducationLevel" class="form-select">
            <option value="">Prefer not to say</option>
            <option>No formal qualification</option>
            <option>Matric</option>
            <option>Certificate</option>
            <option>Diploma</option>
            <option>Degree</option>
            <option>Postgraduate</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Gender (bursary eligibility only, never used for AI scoring)</label>
        <select asp-for="GenderDeclared" class="form-select">
            <option value="">Prefer not to say</option>
            <option>Woman</option>
            <option>Man</option>
            <option>Non-binary</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Household income band (bursary eligibility only)</label>
        <select asp-for="HouseholdIncomeBand" class="form-select">
            <option value="">Prefer not to say</option>
            <option>Low</option>
            <option>Medium</option>
            <option>High</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Field of study</label>
        <input asp-for="FieldOfStudy" class="form-control" placeholder="e.g. Computer Science, or leave blank" />
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" class="form-control max-w-xs" />
    </div>

    <div class="mb-3">
        <label class="form-label">Career interests</label>
        <textarea asp-for="CareerInterests" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">GitHub profile</label>
        <input asp-for="GitHubProfile" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">LinkedIn profile</label>
        <input asp-for="LinkedInProfile" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Languages/competencies I want to be tested on</label>
        <p class="text-muted small mb-2">Select any you'd like to practice or take a practical assessment in - this isn't tied to a specific job, and shows up on your Skills Passport as "looking to be tested on."</p>
        <div class="row">
            @foreach (var competency in availableCompetencies)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="PreferredCompetencyIds" value="@competency.Id" id="pref-@competency.Id"
                               checked="@(Model.PreferredCompetencyIds.Contains(competency.Id))" />
                        <label class="form-check-label" for="pref-@competency.Id">@competency.Name</label>
                    </div>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" asp-route-candidateProfileId="@candidateProfileId" class="btn btn-secondary">Cancel</a>
</form>
