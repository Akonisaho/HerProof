@model HerProof.Domain.Identity.CandidateProfile
@{
    ViewData["Title"] = "Your profile";
}

<h1>Your profile</h1>
@if (Context.Request.Query["incomplete"] == "1" && !Model.IsComplete)
{
    <div class="dev-link-box mb-3">
        <p class="dev-link-label mb-0">Complete your profile to continue</p>
        <p class="mb-0">Province, education level and career interests are needed before you can browse opportunities, submit a repository, or take an assessment or interview.</p>
    </div>
}
<p><a asp-action="Edit" asp-route-candidateProfileId="@Model.Id" class="btn-brand btn-sm">Edit profile</a></p>
<dl>
    <dt>Province</dt>
    <dd>@(Model.Province ?? "Not set")</dd>
    <dt>Education level</dt>
    <dd>@(Model.EducationLevel ?? "Not set")</dd>
    <dt>Gender</dt>
    <dd>@(Model.GenderDeclared ?? "Not set")</dd>
    <dt>Household income band</dt>
    <dd>@(Model.HouseholdIncomeBand ?? "Not set")</dd>
    <dt>Field of study</dt>
    <dd>@(Model.FieldOfStudy ?? "Not set")</dd>
    <dt>Date of birth</dt>
    <dd>@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "Not set")</dd>
    <dt>Career interests</dt>
    <dd>@(Model.CareerInterests ?? "Not set")</dd>
    <dt>GitHub profile</dt>
    <dd>
        @if (!string.IsNullOrWhiteSpace(Model.GitHubProfile))
        {
            <a href="@Model.GitHubProfile" target="_blank" rel="noopener">@Model.GitHubProfile</a>
        }
        else
        {
            <text>Not set</text>
        }
    </dd>
    <dt>LinkedIn profile</dt>
    <dd>
        @if (!string.IsNullOrWhiteSpace(Model.LinkedInProfile))
        {
            <a href="@Model.LinkedInProfile" target="_blank" rel="noopener">@Model.LinkedInProfile</a>
        }
        else
        {
            <text>Not set</text>
        }
    </dd>
</dl>
