@model HerProof.Web.Models.Opportunities.OrganisationOpportunityDetailViewModel
@{
    ViewData["Title"] = Model.Opportunity.Title;
    var organisationId = Model.Opportunity.OrganisationId;
    var opportunityId = Model.Opportunity.Id;
}

<div class="hero-wrap hero-wrap-tight">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <a asp-controller="OrganisationDashboard" asp-action="Index" asp-route-organisationId="@organisationId" class="hero-eyebrow text-decoration-none d-inline-block mb-1">&larr; Dashboard</a>
        <span class="hero-eyebrow d-block">@Model.Opportunity.OpportunityType</span>
        <h1>@Model.Opportunity.Title</h1>
        <p class="opportunity-meta mb-2">Status: <span class="device-pill @(Model.Opportunity.Status == HerProof.Domain.Opportunities.OpportunityStatus.Published ? "detected" : "")">@Model.Opportunity.Status</span></p>
        <p class="lead lead-full mb-3">@Model.Opportunity.Description</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Applications" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" class="btn-brand-outline">Review applications</a>
            @if (Model.Opportunity.Status == HerProof.Domain.Opportunities.OpportunityStatus.Draft)
            {
                <form asp-action="Publish" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" method="post" class="d-inline">
                    <button type="submit" class="btn-brand">Publish</button>
                </form>
            }
            else if (Model.Opportunity.Status == HerProof.Domain.Opportunities.OpportunityStatus.Published)
            {
                <form asp-action="Close" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger">Close</button>
                </form>
            }
        </div>
    </div>
</div>

<section class="brand-section brand-section-tight">
    <div class="brand-card mb-4">
        <h3>Practical assessment for this role</h3>
        @if (Model.LinkedAssessment is (string title, string assessmentType, int durationMinutes))
        {
            <p class="mb-2">
                Candidates applying for this role are directed straight to: <strong>@title</strong>
                (@assessmentType &middot; @durationMinutes min).
            </p>
            <form asp-action="UnlinkAssessment" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" method="post">
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove this assessment from the role</button>
            </form>
        }
        else if (Model.OwnPublishedAssessments.Count > 0)
        {
            <p class="text-muted">No assessment attached yet - candidates only see the generic, competency-matched list.</p>
            <form asp-action="LinkAssessment" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" method="post" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Assessment</label>
                    <select name="assessmentId" class="form-select">
                        @foreach (var a in Model.OwnPublishedAssessments)
                        {
                            <option value="@a.Id">@a.Title (@a.AssessmentType &middot; @a.DurationMinutes min)</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn-brand-outline">Attach to this role</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-2">You haven't published a practical assessment yet.</p>
            <a asp-controller="Assessments" asp-action="Create" class="btn-brand-outline">Create an assessment</a>
        }
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="brand-card h-100">
                <h3>Required competencies</h3>
                @if (Model.Opportunity.RequiredCompetencies.Count == 0)
                {
                    <p class="text-muted">None added yet.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var rc in Model.Opportunity.RequiredCompetencies)
                        {
                            <li>@Model.CompetencyNames.GetValueOrDefault(rc.CompetencyId, "(unknown)") - level @rc.RequiredLevel @(rc.IsMandatory ? "(mandatory)" : "(preferred)")</li>
                        }
                    </ul>
                }
                <form asp-action="AddCompetency" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" method="post" class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Competency</label>
                        <select name="CompetencyId" class="form-select">
                            @foreach (var c in Model.AvailableCompetencies)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Required level</label>
                        <input type="number" name="RequiredLevel" min="0" max="4" class="form-control" value="2" />
                    </div>
                    <div class="col-auto form-check">
                        <input type="checkbox" name="IsMandatory" value="true" class="form-check-input" checked />
                        <label class="form-check-label">Mandatory</label>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn-brand-outline">Add requirement</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-6">
            <div class="brand-card h-100">
                <h3>Eligibility rules</h3>
                @if (Model.Opportunity.EligibilityRules.Count == 0)
                {
                    <p class="text-muted">None added yet.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var rule in Model.Opportunity.EligibilityRules)
                        {
                            <li>@rule.RuleType @rule.Operator "@rule.Value" @(rule.IsHardFilter ? "(hard filter)" : "(informational)") - @rule.Explanation</li>
                        }
                    </ul>
                }
                <form asp-action="AddEligibilityRule" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" method="post" class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Rule type</label>
                        <select name="RuleType" asp-items="Html.GetEnumSelectList<HerProof.Domain.Opportunities.EligibilityRuleType>()" class="form-select"></select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Operator</label>
                        <select name="Operator" asp-items="Html.GetEnumSelectList<HerProof.Domain.Opportunities.EligibilityOperator>()" class="form-select"></select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Value</label>
                        <input name="Value" class="form-control" placeholder="e.g. Gauteng, or Low,Medium, or 18-25, or Any" />
                    </div>
                    <div class="col-auto form-check">
                        <input type="checkbox" name="IsHardFilter" value="true" class="form-check-input" />
                        <label class="form-check-label">Hard filter</label>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Explanation</label>
                        <input name="Explanation" class="form-control" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn-brand-outline">Add rule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
