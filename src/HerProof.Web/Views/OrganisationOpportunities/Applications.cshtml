@model HerProof.Web.Models.Opportunities.OrganisationApplicationsViewModel
@using HerProof.Domain.Opportunities
@{
    ViewData["Title"] = $"Applications - {Model.Opportunity.Title}";
    var organisationId = Model.Opportunity.OrganisationId;
    var opportunityId = Model.Opportunity.Id;

    static string EligibilityBadge(EligibilityResult result) => result switch
    {
        EligibilityResult.Met => "status-pill status-pill-success",
        EligibilityResult.NotMet => "status-pill status-pill-danger",
        _ => "status-pill status-pill-warning",
    };
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Applications</span>
        <h1>@Model.Opportunity.Title</h1>
        <p class="lead lead-full mb-0">@Model.Applications.Count application(s) received.</p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    <p><a asp-action="Details" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId">← Back to opportunity</a></p>

    @if (Model.Applications.Count == 0)
    {
        <div class="brand-card">
            <p class="mb-0 text-muted">No applications yet.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model.Applications)
            {
                <div class="brand-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <strong>@item.CandidateName</strong>
                            <span class="opportunity-org d-block">Submitted @item.Application.SubmittedAtUtc.ToString("yyyy-MM-dd")</span>
                        </div>
                        <span class="device-pill @(item.Application.Status == CandidateApplicationStatus.Reviewed ? "detected" : "")">@item.Application.Status</span>
                    </div>

                    @if (item.AttachedCredentials.Count > 0)
                    {
                        <div class="mt-2">
                            <span class="text-muted small">Attached verified credentials:</span>
                            <ul class="mb-0">
                                @foreach (var (identifier, competencyName) in item.AttachedCredentials)
                                {
                                    <li>@competencyName - <code>@identifier</code></li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small mt-2">No passport credentials attached.</div>
                    }

                    @if (item.Eligibility is not null && item.Eligibility.Rules.Count > 0)
                    {
                        <div class="mt-2">
                            <span class="text-muted small d-block mb-1">Eligibility</span>
                            @foreach (var rule in item.Eligibility.Rules)
                            {
                                <span class="@EligibilityBadge(rule.Result) me-1 mb-1 d-inline-block" title="@rule.Explanation">
                                    @rule.RuleType: @rule.Result@(rule.IsHardFilter ? " (required)" : "")
                                </span>
                            }
                        </div>
                    }

                    @if (item.PassportCertificateUrl is not null)
                    {
                        <div class="mt-2">
                            <a href="@item.PassportCertificateUrl" target="_blank" rel="noopener" class="btn-brand-outline btn-sm">View verified passport</a>
                        </div>
                    }

                    @if (item.Application.Status != CandidateApplicationStatus.Reviewed)
                    {
                        <form asp-action="MarkApplicationReviewed" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunityId" asp-route-applicationId="@item.Application.Id" method="post" class="mt-2">
                            <button type="submit" class="btn-brand-outline btn-sm">Mark reviewed</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</section>
