@model HerProof.Web.Models.Opportunities.CreateOpportunityViewModel
@{
    ViewData["Title"] = "Post an opportunity";
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">New opportunity</span>
        <h1>Post an opportunity</h1>
        <p class="lead lead-full mb-0">It goes live on the public Opportunities page as soon as you create it - you can close it again any time from its detail page.</p>
    </div>
</div>

<section class="brand-section">
    <div class="brand-card" style="max-width: 640px; margin: 0 auto;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="OpportunityType" class="form-label"></label>
                <select asp-for="OpportunityType" asp-items="Html.GetEnumSelectList<HerProof.Domain.Opportunities.OpportunityType>()" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DeadlineUtc" class="form-label"></label>
                <input asp-for="DeadlineUtc" class="form-control" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label asp-for="SalaryMin" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input asp-for="SalaryMin" class="form-control" placeholder="Leave blank for N/A" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="SalaryMax" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input asp-for="SalaryMax" class="form-control" placeholder="Leave blank for a single amount" />
                    </div>
                </div>
                <div class="form-text">Leave both blank to show "Salary: N/A." Fill in only the minimum for a single amount, or both for a range.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ExperienceYearsRequired" class="form-label"></label>
                <input asp-for="ExperienceYearsRequired" class="form-control" placeholder="Leave blank if not applicable" />
            </div>
            <button type="submit" class="btn-brand">Post opportunity</button>
        </form>
    </div>
    <p class="text-center text-muted small mt-3" style="max-width: 640px; margin: 1rem auto 0;">
        Want candidates to solve a real problem you set yourself? Once this is posted, its detail page
        lets you <a asp-controller="Assessments" asp-action="Create">write your own practical
        assessment</a> - your own prompt, your own starter code, and your own hidden test that actually
        grades it - and attach it to this role.
    </p>
</section>
