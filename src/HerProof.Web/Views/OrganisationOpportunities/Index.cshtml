@model IReadOnlyList<HerProof.Domain.Opportunities.Opportunity>
@{
    ViewData["Title"] = "Your opportunities";
    var organisationId = (Guid)ViewBag.OrganisationId;
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Your organisation</span>
        <h1>Your opportunities</h1>
        <p class="lead lead-full mb-0">Jobs, internships and bursaries you've posted go live immediately - manage them here.</p>
    </div>
</div>

<section class="brand-section">
    <p><a asp-action="Create" asp-route-organisationId="@organisationId" class="btn-brand">Post a new opportunity</a></p>

    @if (Model.Count == 0)
    {
        <div class="brand-card">
            <p class="mb-0">You haven't posted anything yet.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var opportunity in Model)
            {
                <a asp-action="Details" asp-route-organisationId="@organisationId" asp-route-opportunityId="@opportunity.Id" class="opportunity-card brand-card d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong>@opportunity.Title</strong>
                        <span class="opportunity-org d-block">@opportunity.OpportunityType</span>
                    </div>
                    <span class="device-pill @(opportunity.Status == HerProof.Domain.Opportunities.OpportunityStatus.Published ? "detected" : "")">@opportunity.Status</span>
                </a>
            }
        </div>
    }
</section>
