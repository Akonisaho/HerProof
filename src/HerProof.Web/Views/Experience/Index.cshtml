@model IReadOnlyList<HerProof.Domain.Experience.ExperienceRecord>
@{
    ViewData["Title"] = "Beyond Employment";
    var competencyNames = (IReadOnlyDictionary<Guid, string>)ViewBag.CompetencyNames;
}

<h1>Beyond Employment</h1>
<p><a asp-action="Create" class="btn btn-primary">Add experience</a></p>

@foreach (var record in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@record.Title <small class="text-muted">(@record.Category)</small></h2>
            <p>@record.Description</p>

            @if (record.SuggestedCompetencies.Count == 0)
            {
                <p class="text-muted">No competency suggestions for this one yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var mapping in record.SuggestedCompetencies)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                @competencyNames.GetValueOrDefault(mapping.CompetencyId, "(unknown)")
                                — <strong>@mapping.MappingStatus</strong>
                            </span>
                            @if (mapping.MappingStatus == HerProof.Domain.Experience.ExperienceCompetencyMappingStatus.Suggested)
                            {
                                <span>
                                    <form asp-action="Confirm" asp-route-experienceCompetencyId="@mapping.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-experienceCompetencyId="@mapping.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Reject</button>
                                    </form>
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}
