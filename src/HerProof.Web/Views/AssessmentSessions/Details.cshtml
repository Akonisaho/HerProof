@model HerProof.Domain.Assessments.AssessmentSession
@using System.Text.Json
@using HerProof.Domain.Assessments
@{
    ViewData["Title"] = "Assessment session";
    var assessment = (Assessment)ViewBag.Assessment;
    var eventToken = ViewBag.EventToken as string;
    var questionsJson = JsonSerializer.Serialize(assessment.Questions.OrderBy(q => q.Order).Select(q => new
    {
        fileName = q.FileName,
        title = q.Title,
        prompt = q.Prompt,
        starterCode = q.StarterCode,
        questionType = q.QuestionType.ToString(),
    }));
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Practical assessment</span>
        <h1>@assessment.Title</h1>
        <p class="opportunity-meta mb-0">Status: <strong>@Model.Status</strong> · @assessment.DurationMinutes minutes</p>
    </div>
</div>

<section class="brand-section">

@if (Model.Status == AssessmentSessionStatus.Invited)
{
    <div class="brand-card" style="max-width: 640px;">
        <h3>Before you start</h3>
        <p>
            This assessment is monitored in your browser. It only ever records a fixed, published
            list of signals - whether this tab lost focus, your network connection, and whether a
            camera/microphone is plugged in. It <strong>never</strong> captures screen content,
            keystrokes, clipboard contents, or any camera/microphone recording - those are never
            turned on. Every signal is a flag for a human assessor to review, never an automatic
            fail, and you see the same log the assessor sees, live, as it happens.
        </p>
        <form asp-action="Consent" asp-route-sessionId="@Model.Id" method="post">
            <button type="submit" class="btn-brand">I understand - give consent</button>
        </form>
    </div>
}
else if (Model.Status == AssessmentSessionStatus.ConsentGiven)
{
    <div class="brand-card" style="max-width: 640px;">
        <h3>Consent recorded</h3>
        <p>Starting the timer begins your @assessment.DurationMinutes-minute window - the server
           records the exact start time, and that's what decides your deadline, not your browser.</p>
        <form asp-action="Begin" asp-route-sessionId="@Model.Id" method="post">
            <button type="submit" class="btn-brand">Start the timer</button>
        </form>
        <details class="mt-3">
            <summary class="text-muted" style="cursor:pointer;">Prefer the desktop agent instead?</summary>
            <p class="text-muted small mt-2">Launch the HerProof Electron agent with this session token:</p>
            <pre class="small text-pre-wrap">@eventToken</pre>
        </details>
    </div>
}
else if (Model.Status == AssessmentSessionStatus.InProgress)
{
    <div id="practical-assessment"
         data-session-id="@Model.Id"
         data-started-at-utc="@Model.StartedAtUtc?.ToString("o")"
         data-duration-minutes="@assessment.DurationMinutes"
         data-questions='@questionsJson'>
        <div class="brand-card d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div id="timer">00:00</div>
            <div id="device-status" class="opportunity-meta mb-0">
                <span id="camera-status" class="device-pill">Camera: checking…</span>
                <span id="microphone-status" class="device-pill">Microphone: checking…</span>
            </div>
        </div>

        <div class="brand-card mb-3">
            <div id="question-tabs" class="d-flex gap-2 flex-wrap mb-3"></div>
            <div id="question-prompt" class="text-muted mb-2"></div>
            <div id="editor-container" style="height: 360px; border: 1px solid var(--brand-pink-border); border-radius: var(--brand-radius-sm);"></div>
        </div>

        <div class="brand-card mb-3">
            <strong>Integrity log</strong> - exactly what the assessor sees, nothing more
            <ul id="event-list" class="mt-2"></ul>
        </div>

        <form id="submit-form" asp-action="Submit" asp-route-sessionId="@Model.Id" method="post">
            <input type="hidden" name="FilesJson" id="files-json-input" />
            <button type="submit" id="submit-button" class="btn-brand">Submit</button>
        </form>
    </div>
}
else
{
    <div class="brand-card" style="max-width: 640px;">
        <p class="mb-0">
            Submitted @Model.SubmittedAtUtc?.ToString("u").
            @(Model.Status == AssessmentSessionStatus.TimedOut ? "Time ran out before submission - this still counts as a real, evaluated submission, never a fail by default." : "")
            @(Model.Status == AssessmentSessionStatus.Evaluated || Model.Status == AssessmentSessionStatus.Reviewed ? "Automated evaluation complete - awaiting assessor review." : "Awaiting automated evaluation.")
        </p>
        @if (Model.Submission?.TestResultsJson is not null)
        {
            <pre class="small mt-2">@Model.Submission.TestResultsJson</pre>
        }
    </div>
}

@if (Model.Status != AssessmentSessionStatus.InProgress)
{
    <h2 class="h5 mt-4">Integrity log</h2>
    <ul>
        @foreach (var e in Model.IntegrityEvents.OrderBy(e => e.OccurredAtUtc))
        {
            <li>@e.OccurredAtUtc.ToString("u") - @e.EventType</li>
        }
    </ul>
}

</section>

@if (Model.Status == AssessmentSessionStatus.InProgress)
{
    <script src="~/js/practical-assessment.js" asp-append-version="true"></script>
}
