@model HerProof.Domain.Assessments.AssessmentSession
@using HerProof.Domain.Assessments
@{
    ViewData["Title"] = "Assessment session";
    var assessment = (Assessment)ViewBag.Assessment;
    var eventToken = ViewBag.EventToken as string;
}

<h1>@assessment.Title</h1>
<p>Status: <strong>@Model.Status</strong></p>

@if (Model.Status == AssessmentSessionStatus.Invited)
{
    <div class="card">
        <div class="card-body">
            <h2 class="h5">Before you start</h2>
            <p>This assessment is monitored by the HerProof Electron agent, which records only a fixed,
               published list of events — never screen capture, keystrokes, or clipboard contents.
               Events are flags for a human assessor to review, never an automatic fail, and you see
               the same log the assessor sees, live.</p>
            <form asp-action="Consent" asp-route-sessionId="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">I understand — give consent</button>
            </form>
        </div>
    </div>
}
else if (Model.Status == AssessmentSessionStatus.ConsentGiven)
{
    <div class="card">
        <div class="card-body">
            <p>Consent recorded. Launch the HerProof Electron agent with this session token
               (STUB: a manual handoff until full sign-in (P13/HP-025) is built):</p>
            <pre class="small text-pre-wrap">@eventToken</pre>
            <form asp-action="Begin" asp-route-sessionId="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">Start the timer</button>
            </form>
        </div>
    </div>
}
else if (Model.Status == AssessmentSessionStatus.InProgress)
{
    <form asp-action="Submit" asp-route-sessionId="@Model.Id" method="post">
        <div class="mb-3">
            <label class="form-label">Your solution</label>
            <textarea name="Code" class="form-control font-monospace" rows="12"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
}
else
{
    <p>Submitted @Model.SubmittedAtUtc?.ToString("u"). @(Model.Status == AssessmentSessionStatus.Evaluated || Model.Status == AssessmentSessionStatus.Reviewed ? "Automated evaluation complete — awaiting assessor review." : "Awaiting automated evaluation.")</p>
    @if (Model.Submission?.TestResultsJson is not null)
    {
        <pre class="small">@Model.Submission.TestResultsJson</pre>
    }
}

<h2 class="h5 mt-4">Integrity log</h2>
<ul>
    @foreach (var e in Model.IntegrityEvents.OrderBy(e => e.OccurredAtUtc))
    {
        <li>@e.OccurredAtUtc.ToString("u") — @e.EventType</li>
    }
</ul>
