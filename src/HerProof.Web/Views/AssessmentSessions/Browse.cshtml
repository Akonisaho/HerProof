@model IReadOnlyList<HerProof.Domain.Assessments.Assessment>
@{
    ViewData["Title"] = "Practical assessments";
}

<h1>Practical assessments</h1>
<ul class="list-group">
    @foreach (var a in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@a.Title — @a.DurationMinutes min</span>
            <form asp-action="Start" asp-route-assessmentId="@a.Id" method="post">
                <button type="submit" class="btn btn-primary btn-sm">Start</button>
            </form>
        </li>
    }
</ul>
