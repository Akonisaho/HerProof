@model IReadOnlyList<HerProof.Web.Models.Verification.InboxCandidateRow>
@{
    ViewData["Title"] = "Assessor inbox";
    int unreadCount = ViewBag.UnreadCount;
}

<div class="hero-wrap">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero hero-compact">
        <span class="hero-eyebrow">Assessor inbox</span>
        <h1>
            Pending review
            @if (unreadCount > 0)
            {
                <span class="inbox-unread-badge">@unreadCount new</span>
            }
        </h1>
        <p class="lead lead-full mb-0">No email, no polling required - a candidate submitting evidence or completing an assessment lands here immediately, and stays marked "new" until you open it.</p>
    </div>
</div>

<section class="brand-section brand-section-tight">
    @if (Model.Count == 0)
    {
        <div class="brand-card">
            <p class="mb-0 text-muted">Nothing pending review right now.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var row in Model)
            {
                var isUnread = row.UnreadCount > 0;
                <div class="col-md-6 col-lg-4">
                    <a asp-action="CandidateOverview" asp-route-candidateId="@row.CandidateId"
                       class="opportunity-card brand-card h-100 d-block text-decoration-none text-reset @(isUnread ? "inbox-item-unread" : "")">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="opportunity-pill opportunity-pill-job">@row.PendingCount pending</span>
                            @if (isUnread)
                            {
                                <span class="inbox-dot" aria-hidden="true" title="@row.UnreadCount new"></span>
                            }
                        </div>
                        <h3 class="mt-3">@row.CandidateName</h3>
                        <p class="opportunity-org mb-2">@row.CompetencyNames.Count competenc@(row.CompetencyNames.Count == 1 ? "y" : "ies") to review</p>
                        <p class="mb-0">@string.Join(", ", row.CompetencyNames)</p>
                        <div class="opportunity-meta mt-3">
                            <span>🕒 Updated @row.MostRecentUpdateUtc.ToString("d MMM yyyy")</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</section>
